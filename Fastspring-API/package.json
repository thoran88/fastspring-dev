{
  "name": "fastspring-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "tunnel": "ngrok http 3000",
    "dev:tunnel": "concurrently -n server,ngrok -c blue,green \"npm:dev\" \"npm:tunnel\"",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
