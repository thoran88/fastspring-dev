# FastSpring dashboard -> Integrations -> API Credentials
# Use the credentials for your TEST (sandbox) store, not your live store.
FASTSPRING_USERNAME=
FASTSPRING_PASSWORD=

# Public sandbox: same host for sandbox and live (api.fastspring.com) -
# sandbox vs live depends on which store's credentials you use, not this URL.
# Internal FastSpring QA environments differ: each has its own API host,
# e.g. https://qa0-api.fastspring.com for QA0 (storefront domain has
# "test.qa.onfastspring.com" with no number).
FASTSPRING_API_BASE=https://api.fastspring.com

# FastSpring dashboard -> Checkouts -> Popup Checkouts -> your checkout ->
# "Place on your Website" -> copy the data-storefront value verbatim
# (it includes a /popup suffix), e.g. mystore.test.onfastspring.com/popup
FASTSPRING_STOREFRONT=

# FastSpring dashboard -> Developer Tools -> Webhooks -> your webhook -> HMAC SHA256 Secret
FASTSPRING_WEBHOOK_SECRET=

PORT=3000
